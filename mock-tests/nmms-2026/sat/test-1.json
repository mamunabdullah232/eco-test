    {
      "id": "sat01q02",
      "subject": "Mathematics",
      "as": "এটা সামগ্ৰী ₹800-ত কিনি ₹920-ত বিক্ৰী কৰা হ’ল। লাভৰ শতকৰা হাৰ কিমান?",
      "options": [
        {
          "as": "\\(10\\%\\)"
